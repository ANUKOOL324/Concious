# =============================================================================
# REQUIRED — app will not work without these
# =============================================================================
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/concious
JWT_PASSWORD=replace-with-a-long-random-secret

# =============================================================================
# REQUIRED for AI — search, Ashqnor chat, RAG indexing (OKF + embeddings)
# =============================================================================
HF_API_KEY=
HF_EMBEDDING_MODEL=intfloat/e5-small-v2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct

# =============================================================================
# REQUIRED for PDF upload only (POST /api/v1/content/pdf)
# Leave blank if you are not using PDF upload yet.
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# OPTIONAL — app works without these
# =============================================================================
# HF_RERANK_MODEL=BAAI/bge-reranker-base
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
